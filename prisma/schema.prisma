generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id            BigInt    @id @default(autoincrement())
  login_id      String    @unique @db.VarChar(100)
  password_hash String    @db.VarChar(255)
  name          String    @db.VarChar(100)
  role          String?   @default("EDITOR") @db.VarChar(20)
  last_login_at DateTime? @db.Timestamp(6)
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)

  posts Post[]

  @@map("admins")
}

model Page {
  id         BigInt    @id @default(autoincrement())
  page_key   String    @unique @db.VarChar(100)
  page_name  String    @db.VarChar(100)
  is_active  Boolean?  @default(true)
  sort_order Int?      @default(0)
  theme      Json?     @default("{}")
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  contents PageContent[]

  @@map("pages")
}

model PageContent {
  id           BigInt    @id @default(autoincrement())
  page_id      BigInt
  content_type String    @db.VarChar(20)
  title        String?   @db.VarChar(200)
  content      String?
  image_path   String?   @db.VarChar(500)
  data         Json?     @default("{}")
  sort_order   Int?      @default(0)
  is_active    Boolean?  @default(true)
  created_at   DateTime? @default(now()) @db.Timestamp(6)

  page Page @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@index([page_id, sort_order])
  @@map("page_contents")
}

model Popup {
  id         BigInt    @id @default(autoincrement())
  title      String    @db.VarChar(100)
  image_path String?   @db.VarChar(500)
  link_url   String?   @db.VarChar(500)
  start_at   DateTime  @db.Timestamp(6)
  end_at     DateTime? @db.Timestamp(6)
  is_active  Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@map("popups")
}

/// AI 게시판 글. SEO/AI 발견용 공개 콘텐츠 + admin 작성/수정 대상.
model Post {
  id           BigInt   @id @default(autoincrement())
  slug         String   @unique @db.VarChar(120)
  title        String   @db.VarChar(255)
  summary      String?  @db.Text
  content      String   @db.Text
  category     String   @db.VarChar(50)
  tags         String[] @default([])
  language     String   @default("ko-KR") @db.VarChar(10)
  is_published Boolean  @default(true)
  metadata     Json?    @default("{}")
  published_at DateTime @default(now()) @db.Timestamp(6)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  author_id BigInt?
  author    Admin?  @relation(fields: [author_id], references: [id], onDelete: SetNull)

  @@index([is_published, published_at(sort: Desc)])
  @@index([category, published_at(sort: Desc)])
  @@index([slug])
  @@index([tags], type: Gin)
  @@map("posts")
}
